{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whisper_app",
  "version": "0.3.0",
  "identifier": "com.rlucio.whisperapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "whisper_app",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "index.html?w=overlay",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "width": 300,
        "height": 64
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
